# Nunca copiar estas claves a EXPO_PUBLIC_*. Crear .env local sin subirlo a Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
# demo devuelve solo propuestas claramente identificadas; no realiza operaciones ficticias.
AI_PROVIDER=demo
# ollama: http://localhost:11434 ; openai_compatible: https://provider.example/v1
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b
AI_API_KEY=
CORS_ORIGINS=[]
# Solamente integraciones con permiso explícito. No añadir portales para scraping.
# JSON esperado: [{"id":"partner","url":"https://jobs.partner.example/feed.json","authorized":true,"recipient_verification":"source_attestation"}]
AUTHORIZED_JOB_FEEDS=[]
WEB_SEARCH_PROVIDER=
# Tavily: su clave privada se carga solo en el servidor. Nunca EXPO_PUBLIC_.
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_QUERIES=2
WORKER_BATCH_SIZE=10
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/mail/google/callback
# Generar con: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
# false hasta configurar/validar OAuth, fuentes verificadas y prueba controlada.
MAIL_SEND_ENABLED=false
