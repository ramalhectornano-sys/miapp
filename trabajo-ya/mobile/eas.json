{
  "cli": {"version": ">= 16.0.0", "appVersionSource": "local"},
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {"EXPO_PUBLIC_DEMO_MODE": "true", "TRABAJO_YA_BUILD_MODE": "demo"}
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {"buildType": "apk"},
      "env": {"EXPO_PUBLIC_DEMO_MODE": "true", "TRABAJO_YA_BUILD_MODE": "demo"}
    },
    "demo": {"extends": "preview"},
    "preview-real": {
      "distribution": "internal",
      "environment": "preview",
      "android": {"buildType": "apk"},
      "env": {"EXPO_PUBLIC_DEMO_MODE": "false", "TRABAJO_YA_BUILD_MODE": "real"}
    },
    "production": {
      "environment": "production",
      "android": {"buildType": "app-bundle"},
      "env": {"EXPO_PUBLIC_DEMO_MODE": "false", "TRABAJO_YA_BUILD_MODE": "real"}
    }
  }
}
